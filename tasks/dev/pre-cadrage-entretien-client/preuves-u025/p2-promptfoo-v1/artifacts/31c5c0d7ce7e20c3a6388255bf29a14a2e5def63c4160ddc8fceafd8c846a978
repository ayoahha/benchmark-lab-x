"use strict";
// Calibration de l'instrument gates.js AVANT l'unique exécution promptfoo réelle.
// Rejoue les cinq portes par cas avec la même interface (output, context) que promptfoo,
// applique la projection native (exception -> HARNESS_ERROR ; pass:false -> FAIL ; sinon PASS)
// et compare à l'oracle P1 (p1-local-v2/oracle.json). Sortie: JSON de calibration, code 0 si 16/16.
const fs = require("fs");
const path = require("path");

const [fixturesPath, oraclePath, packageDirAbs, gatesPath] = process.argv.slice(2);
const fixtures = JSON.parse(fs.readFileSync(fixturesPath, "utf8"));
const oracle = JSON.parse(fs.readFileSync(oraclePath, "utf8"));
const gates = require(path.resolve(gatesPath));
const REAL_HASH_ENV = process.env.EMPREINTE_MANIFESTE_REELLE;
if (!REAL_HASH_ENV) {
  process.stderr.write("EMPREINTE_MANIFESTE_REELLE manquante\n");
  process.exit(2);
}

const ORDRE_PORTES = ["G-005", "G-001", "G-002", "G-003", "G-004"];
const FONCTIONS = {
  "G-005": gates.g005,
  "G-001": gates.g001,
  "G-002": gates.g002,
  "G-003": gates.g003,
  "G-004": gates.g004,
};

const rapports = [];
let ecarts = 0;
for (const cas of fixtures.cases) {
  const empreinte = cas.case_id === "WT-HARNESS" ? "empreinte-illisible" : REAL_HASH_ENV;
  const context = {
    vars: {
      case_id: cas.case_id,
      package_dir: packageDirAbs,
      approbateur: "Ayo",
      verdict_approbation: "APPROUVE",
      empreinte_manifeste_approuvee: empreinte,
    },
  };
  const portes = {};
  let statut = "PASS";
  let erreur = null;
  for (const porte of ORDRE_PORTES) {
    try {
      const r = FONCTIONS[porte](cas.candidate, context);
      const pass = r === true || (r && r.pass === true);
      portes[porte] = pass ? "PASS" : "FAIL";
      if (!pass && statut === "PASS") statut = "FAIL";
    } catch (e) {
      portes[porte] = "ERROR";
      statut = "HARNESS_ERROR";
      erreur = e.message;
      break;
    }
  }
  const attendu = oracle[cas.case_id].automatic;
  const attenduPortes = Object.fromEntries(oracle[cas.case_id].gates);
  let portesConformes = true;
  for (const [nomPorte, valeurAttendue] of Object.entries(attenduPortes)) {
    const observee = portes[nomPorte];
    const attendueTexte = valeurAttendue ? "PASS" : (attendu === "HARNESS_ERROR" ? "ERROR" : "FAIL");
    if (observee !== attendueTexte) portesConformes = false;
  }
  const conforme = statut === attendu && portesConformes;
  if (!conforme) ecarts += 1;
  rapports.push({
    case_id: cas.case_id,
    statut_observe: statut,
    statut_attendu: attendu,
    portes_observees: portes,
    portes_oracle: attenduPortes,
    erreur: erreur,
    conforme: conforme,
  });
}
const sortie = {
  schema_version: "u025/p2-promptfoo-calibration/v1",
  cas: rapports,
  total: rapports.length,
  ecarts: ecarts,
  verdict: ecarts === 0 && rapports.length === 16 ? "CALIBRATION_OK" : "CALIBRATION_ECART",
};
process.stdout.write(JSON.stringify(sortie, null, 1) + "\n");
process.exit(sortie.verdict === "CALIBRATION_OK" ? 0 : 1);
