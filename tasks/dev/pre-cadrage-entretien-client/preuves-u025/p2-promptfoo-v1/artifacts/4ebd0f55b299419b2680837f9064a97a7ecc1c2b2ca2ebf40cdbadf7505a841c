#!/bin/sh
# U025-P2-PROMPTFOO-V1 — échantillonneur réseau du processus racine et de ses descendants.
# usage: echantillonneur-lsof.sh <pid_racine> <sortie.jsonl> [intervalle_s]
# Chaque tique : arbre de processus (pgrep -P récursif) puis lsof -a -i (TCP+UDP, IPv4+IPv6).
RACINE=$1
SORTIE=$2
INTERVALLE=${3:-0.1}
SEQ=0
while kill -0 "$RACINE" 2>/dev/null; do
  SEQ=$((SEQ + 1))
  TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  PIDS="$RACINE"
  COURANT="$RACINE"
  while :; do
    ENFANTS=$(pgrep -P "$(printf '%s' "$COURANT" | tr ' ' ',')" 2>/dev/null | tr '\n' ' ' | sed 's/ $//')
    [ -z "$ENFANTS" ] && break
    PIDS="$PIDS $ENFANTS"
    COURANT="$ENFANTS"
  done
  L=$(lsof -a -i -P -n -p "$(printf '%s' "$PIDS" | tr ' ' ',')" 2>/dev/null | tail -n +2)
  if [ -n "$L" ]; then ETAT="SOCKETS_OBSERVEES"; else ETAT="AUCUNE_SOCKET"; fi
  jq -cn --arg ts "$TS" --argjson seq "$SEQ" --arg pids "$PIDS" --arg etat "$ETAT" --arg lsof "$L" \
    '{sequence:$seq, ts:$ts, pids:$pids, etat:$etat, lsof:$lsof}' >> "$SORTIE"
  sleep "$INTERVALLE"
done
