{
  "description": "U025-P2-PROMPTFOO-V1 — transport natif des 16 fixtures figées du paquet PRECADRAGE-ENTRETIEN-CLIENT-V0 par promptfoo@0.122.0, hors campagne, zéro appel candidat, zéro tentative fournisseur, dépense 0. Sorties candidates pré-calculées transportées par providerOutput ; portes G-001..G-005 en assertions javascript natives (gates.js).",
  "sharing": false,
  "providers": ["echo"],
  "prompts": ["{{case_id}}"],
  "defaultTest": {
    "vars": {
      "package_dir": "../..",
      "approbateur": "Ayo",
      "verdict_approbation": "APPROUVE"
    }
  },
  "tests": [
    .cases[] | {
      "description": .case_id,
      "vars": {
        "case_id": .case_id,
        "specification_sha256": .specification_sha256,
        "candidate_sha256": .candidate_sha256,
        "empreinte_manifeste_approuvee": (if .case_id == "WT-HARNESS" then "empreinte-illisible" else $empreinte_reelle end)
      },
      "providerOutput": .candidate,
      "assert": [
        {"type": "javascript", "value": "file://gates.js:g005", "metric": "G-005"},
        {"type": "javascript", "value": "file://gates.js:g001", "metric": "G-001"},
        {"type": "javascript", "value": "file://gates.js:g002", "metric": "G-002"},
        {"type": "javascript", "value": "file://gates.js:g003", "metric": "G-003"},
        {"type": "javascript", "value": "file://gates.js:g004", "metric": "G-004"}
      ]
    }
  ]
}
