{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "u025/p3-authorization/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "authorization_id", "lock_root_sha256",
    "budget_sha256", "stage", "path", "configuration", "attempt_id",
    "stimulus_sha256", "authorizations", "new_charge_allowed",
    "extra_spend_cap_usd", "retry_of", "go_evidence", "prev_receipt_sha256",
    "prev_receipt_path", "order", "storage"
  ],
  "properties": {
    "schema_version": {"const": "u025/p3-authorization/v3"},
    "authorization_id": {"type": "string", "minLength": 1},
    "lock_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budget_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {"enum": ["canary", "campaign"]},
    "path": {"enum": ["promptfoo", "ori", "manual"]},
    "configuration": {"enum": ["grok46_xai_build_oauth", "kimi_k3_opencode_zen"]},
    "attempt_id": {"type": "string", "minLength": 1},
    "stimulus_sha256": {"const": "20f0be450640704b0c467eee57ca2ea58a4d629e63eba3efccbc6f68440e07e4"},
    "authorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_call", "provider_attempt", "stage", "spend_or_quota"],
      "properties": {
        "candidate_call": {"const": true},
        "provider_attempt": {"const": true},
        "stage": {"const": true},
        "spend_or_quota": {"const": true}
      }
    },
    "new_charge_allowed": {"const": false},
    "extra_spend_cap_usd": {"const": 0},
    "retry_of": {"type": "null"},
    "go_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_call", "provider_attempt", "stage", "spend_or_quota"],
      "properties": {
        "candidate_call": {"$ref": "#/$defs/go"},
        "provider_attempt": {"$ref": "#/$defs/go"},
        "stage": {"$ref": "#/$defs/go"},
        "spend_or_quota": {"$ref": "#/$defs/go"}
      }
    },
    "prev_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prev_receipt_path": {"type": "string", "minLength": 1},
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitment_sha256", "position", "salt_revealed"],
      "properties": {
        "commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "position": {"type": "integer", "minimum": 1, "maximum": 6},
        "salt_revealed": {"const": false}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "content_addressed_write"],
      "properties": {
        "uri": {"const": "/Users/ayo/Documents/benchmark-lab-x-private/p3-v1/raw/sha256/"},
        "content_addressed_write": {"const": true}
      }
    }
  },
  "$defs": {
    "go": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go_id", "authorized_by", "url", "artifact_path", "body_sha256"],
      "properties": {
        "go_id": {"type": "string", "minLength": 1},
        "authorized_by": {"const": "ayoahha"},
        "url": {"type": "string", "pattern": "^https://github\\.com/ayoahha/benchmark-lab-x/issues/[0-9]+#issuecomment-[0-9]+$"},
        "artifact_path": {"type": "string", "minLength": 1},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
