{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "u025/p3-receipt/v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "prev_receipt_sha256",
    "prev_receipt_path", "lock_root_sha256", "authorization_sha256",
    "attempt", "input", "requested", "expected", "observed",
    "artifacts", "latency", "cost", "incident", "automatic_controls",
    "human_review", "effort", "report", "result"
  ],
  "properties": {
    "schema_version": {"const": "u025/p3-receipt/v2"},
    "receipt_id": {"type": "string", "minLength": 1},
    "prev_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prev_receipt_path": {"type": "string", "minLength": 1},
    "lock_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "attempt_id", "path", "configuration", "retry_of", "position"],
      "properties": {
        "stage": {"enum": ["canary", "campaign"]},
        "attempt_id": {"type": "string"},
        "path": {"enum": ["promptfoo", "ori", "manual"]},
        "configuration": {"enum": ["grok46_xai_build_oauth", "kimi_k3_opencode_zen"]},
        "retry_of": {"type": "null"},
        "position": {"type": "integer", "minimum": 1, "maximum": 6}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stimulus_sha256", "system_prompt_sha256"],
      "properties": {
        "stimulus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "system_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "requested": {"type": "object", "minProperties": 1},
    "expected": {"type": "object", "minProperties": 1},
    "observed": {"type": "object", "minProperties": 1},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_response_sha256", "candidate_output_sha256", "raw_store_uri"],
      "properties": {
        "raw_response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_store_uri": {"const": "/Users/ayo/Documents/benchmark-lab-x-private/p3-v1/raw/sha256/"}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "elapsed_ns"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "elapsed_ns": {"type": "integer", "minimum": 0}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency", "tariff_source", "observed_units", "cache",
        "calculated_provider_cost", "observed_billed", "extra_spend_usd",
        "counts_as_attempt", "limitation"
      ],
      "properties": {
        "currency": {"const": "USD"},
        "tariff_source": {"type": "object"},
        "observed_units": {"$ref": "#/$defs/unknown_or_observed"},
        "cache": {"$ref": "#/$defs/unknown_or_observed"},
        "calculated_provider_cost": {"$ref": "#/$defs/unknown_or_observed"},
        "observed_billed": {"$ref": "#/$defs/unknown_or_observed"},
        "extra_spend_usd": {"const": 0},
        "counts_as_attempt": {"const": true},
        "limitation": {"enum": ["INCONNU", "HOLD", null]}
      }
    },
    "incident": {"type": ["object", "null"]},
    "automatic_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gates", "validator_sha256"],
      "properties": {
        "status": {"enum": ["PENDING", "PASS", "FAIL", "HARNESS_ERROR"]},
        "gates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {"enum": ["G-005", "G-001", "G-002", "G-003", "G-004"]},
              {"type": "boolean"}
            ]
          }
        },
        "validator_sha256": {"const": "e631184b84270c4b3dbf931910436ad65b7d08c02016c94d2dfe53e27ead2056"}
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rubric", "verdict", "llm_judge"],
      "properties": {
        "status": {"enum": ["PENDING", "FROZEN"]},
        "rubric": {"const": "HR-001"},
        "verdict": {"enum": [null, "ACCEPTABLE", "NOT_ACCEPTABLE", "UNABLE_TO_JUDGE"]},
        "llm_judge": {"const": false}
      }
    },
    "effort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration", "integration", "execution", "human_review",
        "verification", "maintenance", "report_production"
      ],
      "properties": {
        "configuration": {"type": ["number", "null"]},
        "integration": {"type": ["number", "null"]},
        "execution": {"type": ["number", "null"]},
        "human_review": {"type": ["number", "null"]},
        "verification": {"type": ["number", "null"]},
        "maintenance": {"type": ["number", "null"]},
        "report_production": {"type": ["number", "null"]}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "public_path"],
      "properties": {
        "status": {"enum": ["PENDING", "PUBLISHED"]},
        "public_path": {"const": "tasks/dev/pre-cadrage-entretien-client/preuves-u025/p3-v1/"}
      }
    },
    "result": {"enum": ["PASS", "CANDIDATE_NOT_ACCEPTABLE", "PROVIDER_FAILURE", "HARNESS_ERROR", "INCONNU", "UNABLE_TO_JUDGE", "HOLD"]}
  },
  "$defs": {
    "unknown_or_observed": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["INCONNU", "OBSERVED", "HOLD"]}
      }
    }
  }
}
